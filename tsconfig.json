{
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom"],
    "types": ["vite/client"],
    "strictNullChecks": false,
    "skipLibCheck": true,
  },
  "include": ["src/plugins/*.ts", "src/plugins/*.d.ts", "src/plugins/*.tsx", "src/plugins/*.vue"]
}
